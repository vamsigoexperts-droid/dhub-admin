# Copy to .env and adjust. Restart Vite after changes (npm run dev).

# Backend API root (trailing slash optional); production default
VITE_API_BASE_URL=https://api.doorstephub.com/

# Static uploads / images (default: production)
# VITE_MEDIA_BASE_URL=https://api.doorstephub.com/

VITE_GOOGLE_MAPS_API_KEY=

# --- Local development (optional) ---
# The repo includes .env.development so `npm run dev` proxies /v1 to http://127.0.0.1:5011.
# Run the API: npm start in the backend folder, then npm run dev here.
# Override port: VITE_DEV_PROXY_TARGET=http://127.0.0.1:YOUR_PORT (and set VITE_MEDIA_BASE_URL to match).

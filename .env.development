# Used only when you run: npm run dev (Vite development mode)
# REST calls go to the Vite dev server, which proxies /v1 → local Node (see vite.config.js).
# Start the API first: cd "backend api's" && npm start   (default port 5011)

VITE_API_BASE_URL=https://api.doorstephub.com/
VITE_MEDIA_BASE_URL=https://api.doorstephub.com/

# Proxy target for vite.config.js (REST + paths under /v1)
VITE_DEV_PROXY_TARGET=https://api.doorstephub.com
